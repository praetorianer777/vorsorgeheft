  "fixed_sql": [
    {
      "name": "persons",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"persons\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"date_of_birth\" TEXT NOT NULL, \"sex\" INTEGER NOT NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "completions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"completions\" (\"person_id\" TEXT NOT NULL REFERENCES persons (id) ON DELETE CASCADE, \"rule_id\" TEXT NOT NULL, \"dose_id\" TEXT NOT NULL DEFAULT '', \"completed_on\" TEXT NOT NULL, \"skipped\" INTEGER NOT NULL DEFAULT 0 CHECK (\"skipped\" IN (0, 1)), \"note\" TEXT NULL, PRIMARY KEY (\"person_id\", \"rule_id\", \"dose_id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "changes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"changes\" (\"entity\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"field\" TEXT NOT NULL, \"hlc\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"entity\", \"entity_id\", \"field\"));"
        }
      ]
    },
    {
      "name": "peers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"peers\" (\"node_id\" TEXT NOT NULL, \"device_name\" TEXT NOT NULL, \"shared_key\" TEXT NOT NULL, \"last_sync_hlc\" TEXT NULL, \"last_sync_at\" TEXT NULL, PRIMARY KEY (\"node_id\"));"
        }
      ]
    }
