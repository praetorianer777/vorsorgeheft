<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower, which cannot tell a cloud backup from a device
     transfer. Both use these rules, so nothing is backed up there; the
     encrypted export file is the way over to another phone. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
</full-backup-content>
